# Copy this file to .env.local for local development.
# All values below are local/mock examples. Never use production credentials here.

# Public API endpoints (these values are exposed to the browser by Next.js).
NEXT_PUBLIC_API_BASE_URL=https://dev-api.metarang.com
NEXT_PUBLIC_ADMIN_API_BASE_URL=https://dev-admin.metarang.com

# Optional public hero video CDN base URL.
# Leave empty to use the local Next.js proxy route.
NEXT_PUBLIC_HERO_VIDEO_BASE=

# Server-only webhook authentication secret.
# Replace with a unique random value outside production.
WEBHOOK_SECRET=local-mock-webhook-secret-change-me

# Server-only SMTP configuration.
# Use a local mail catcher or mock SMTP service for isolated tests.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=local-test
SMTP_PASS=local-test-password
EMAIL_FROM=no-reply@example.test
EMAIL_TO=developer@example.test

# Server-to-server Go service configuration.
# These values must never use the NEXT_PUBLIC_ prefix.
INTERNAL_GO_SERVICE_URL=http://127.0.0.1:8080
INTERNAL_SERVICE_KEY=local-mock-internal-service-key-change-me

# Shared server-only secret for HMAC-SHA256 cache invalidation signatures.
# Generate a unique secret for each real environment.
CACHE_INVALIDATION_HMAC_SECRET=local-mock-hmac-secret-change-me

# Optional bundle analysis.
ANALYZE=false
