    "name": "string",
    "url": "url",
    "image": "url-array",
    "jobTitle": "string",
    "description": "string",
    "alternateName": "string"
  },
  "placeholders": [
    "name",
    "profileUrl",
    "images",
    "jobTitle",
    "description",
    "alternateName"
  ],
  "template": {
    "@context": "https://schema.org",
